APP_ENV=development
API_PORT=8000
WEB_PORT=5173
POSTGRES_PASSWORD=postgres
DATABASE_URL=postgresql+psycopg://postgres:postgres@db:5432/local_explorer
REDIS_URL=redis://redis:6379/0
RATE_LIMIT_ENABLED=false
RATE_LIMIT_GENERAL_PER_MINUTE=120
RATE_LIMIT_AUTH_PER_MINUTE=10
RATE_LIMIT_CHAT_PER_MINUTE=20
RATE_LIMIT_COSTLY_PER_MINUTE=30
# Wrong-password throttle (per e-mail+IP / per e-mail / per IP within the window)
AUTH_LOGIN_WINDOW_SECONDS=900
AUTH_LOGIN_MAX_FAILURES_PER_ACCOUNT_IP=5
AUTH_LOGIN_MAX_FAILURES_PER_ACCOUNT=20
AUTH_LOGIN_MAX_FAILURES_PER_IP=50
# Unset = on in production, off elsewhere
# ADMIN_MFA_REQUIRED=true
# ALLOW_PROVIDER_ACCESS_KEY=false
TRUSTED_PROXY_IPS=
# SMTP and WEB_APP_URL are required for password-reset and email-verification links (booking needs a verified email).
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=Local Explorer AI
SMTP_STARTTLS=true
SMTP_USE_SSL=false
NOTIFICATION_MAX_ATTEMPTS=5
NOTIFICATION_POLL_SECONDS=5
# VAPID keys (leave blank to disable web push). Keep the private key in your secret manager.
# Generate with: npx web-push generate-vapid-keys
WEB_PUSH_VAPID_PUBLIC_KEY=
WEB_PUSH_VAPID_PRIVATE_KEY=
WEB_PUSH_VAPID_SUBJECT=mailto:ops@example.com
# Open-Meteo's public service is for non-commercial use; set paid/customer endpoints as applicable.
OPEN_METEO_FORECAST_URL=https://api.open-meteo.com/v1/forecast
OPEN_METEO_AIR_QUALITY_URL=https://air-quality-api.open-meteo.com/v1/air-quality
OPEN_METEO_API_KEY=
OPEN_METEO_CACHE_TTL_SECONDS=600
CORS_ORIGINS=http://localhost:5173
ROUTING_PROVIDER=goong
REAL_DATA_ONLY=true
MAP_PROVIDER=osm
GEOCODING_PROVIDER=goong
GOONG_API_BASE_URL=https://rsapi.goong.io
GOONG_TIMEOUT_SECONDS=8
GOONG_ETA_TTL_SECONDS=300
GEOCODE_CACHE_TTL_SECONDS=86400
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
GEMINI_MODEL=gemini-2.5-flash
OPENAI_TIMEOUT_SECONDS=30
LLM_FALLBACK_ENABLED=false
APP_SIGNING_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback
# Google Maps rating shown beside traveler reviews of landmarks (Places API (New)). Leave the key empty to hide the Google block.
# The monthly cap stops calls once reached, so a demo stays inside the free allowance.
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACES_MONTHLY_CALL_CAP=900
GOOGLE_PLACES_CACHE_HOURS=24
WEB_APP_URL=http://localhost:5173
# Partner/admin portal (apps/portal). Account emails for partner and admin users link here.
PORTAL_APP_URL=http://localhost:5174
VNPAY_ENVIRONMENT=sandbox
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_PAYMENT_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
# Set both to the public HTTPS API URLs (VNPay cannot call localhost/private IPs).
VNPAY_RETURN_URL=
VNPAY_IPN_URL=
PAYMENT_PROVIDER=vnpay
MOMO_ENVIRONMENT=sandbox
MOMO_PARTNER_CODE=
MOMO_ACCESS_KEY=
MOMO_SECRET_KEY=
MOMO_API_URL=https://test-payment.momo.vn/v2/gateway/api/create
MOMO_RETURN_URL=
MOMO_IPN_URL=
# Required for admin-managed integration values; generate with Fernet.generate_key(). Keep stable and out of the database.
INTEGRATION_SECRETS_KEY=
DEMO_ADMIN_EMAIL=localexplorerai@admin.com
DEMO_ADMIN_PASSWORD=
DEMO_TRAVELER_EMAIL=baothang@gmail.com
DEMO_TRAVELER_PASSWORD=
INSTALL_E5=false
INSTALL_ML=false
E5_MODEL_PATH=/models/e5
RANKER_MODEL_DIR=/models/ai-ranker
ENABLE_BOOTSTRAP_RANKER=false
FLOOD_MODEL_DIR=/models/flood-risk
ALLOW_UNVERIFIED_RANKER=false
GOONG_API_KEY=
VMAP_API_KEY=

# --- Authentication (RS256 JWT). Required in EVERY environment, including development. ---
# Generate with:  cd apps/api && python -m scripts.generate_auth_keys
AUTH_JWT_KEY_ID=
AUTH_JWT_PRIVATE_KEY_B64=
# Retired public keys still honoured while their tokens live, as JSON: {"2026-04": "<base64 pem>"}
AUTH_JWT_PUBLIC_KEYS_B64=
AUTH_ISSUER=local-explorer-ai
AUTH_AUDIENCE=local-explorer-api
AUTH_ACCESS_TTL_SECONDS=900
AUTH_REFRESH_TTL_SECONDS=604800
AUTH_ADMIN_REFRESH_TTL_SECONDS=86400
AUTH_ABSOLUTE_TTL_SECONDS=2592000
AUTH_ADMIN_ABSOLUTE_TTL_SECONDS=604800
